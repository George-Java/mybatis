<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lindu.mapper.StudentMapper">
    <select id="selectByCid" resultType="com.lindu.po.Student">
        select sid, sname,cid
        from tb_student
        <where>
            cid=#{cid}
        </where>
    </select>
</mapper>